#:import utils kivy.utils
#:import Animation kivy.animation.Animation

# --- CUSTOM BUTTON DESIGN ---
<GoldButton@Button>:
    text_alpha: 1.0  # <--- Add this property for text-only fading
    btn_color: app.charcoal2 if (app and hasattr(app, 'app.charcoal2') and app.charcoal2) else '#1A2123'
    text_color: app.text_color1 if (app and hasattr(app, 'app.text_color1') and app.text_color1) else '#4CEB63'
    # Remove the default Kivy grey button background
    background_color: 0, 0, 0, 0
    background_normal: ''


    # 2. The suppressed tap animation
    opacity: 0.6 if self.state == 'down' else 1.0

    # Text styling
    color: utils.get_color_from_hex(self.text_color if (self.text_color and isinstance(self.text_color, str)) else '#4CEB63')[:3] + [self.text_alpha]
    bold: True
    font_size: '30sp'

    # Sizing (Fixed size so they look uniform)
    size_hint: None, None
    size: dp(260), dp(100)
    pos_hint: {'center_x': 0.5}

    # Drawing the rounded rectangle and border
    canvas.before:
        Color:
            rgba: utils.get_color_from_hex(self.btn_color if (self.btn_color and isinstance(self.btn_color, str)) else '#1A2123')
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [dp(15)] # The curve of the corners

        # Optional: Adds the thin light border seen in your mockup
        Color:
            rgba: 1, 1, 1, 0.6
        Line:
            width: dp(1.0)
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(15))

# --- MAIN SCREEN LAYOUT ---
<HomeScreen>:
    canvas.before:
        Color:
            rgba: utils.get_color_from_hex(app.main_color)
        Rectangle:
            size: self.size
            pos: self.pos

    BoxLayout:
        orientation: 'vertical'
        padding: [dp(20), dp(20), dp(20), dp(20)]

        # 1. TOP SAFE AREA (Notch padding)
        Widget:
            size_hint_y: None
            size_hint_y: 0.05

        FloatLayout:
            size_hint: (1, 0.35)  # Takes up 35% of vertical screen space

            # The Logo Image scaled responsively
            Image:
                source: 'images/Firefly.png'
                size_hint: (1.15, 1.15)  # Scales relative to the container width/height
                pos_hint: {'center_x': 0.5, 'center_y': 0.55}
                allow_stretch: True
                keep_ratio: True

            # SCOREKEEPER text positioned relative to the container
            Label:
                text: "S C O R E K E E P E R"
                font_size: '18sp'
                bold: True
                color: 1, 159/255, 67/255, 1
                size_hint: (1, None)
                height: dp(30)
                pos_hint: {'center_x': 0.5, 'center_y': 0.25}
                halign: 'center'
                valign: 'middle'
                text_size: self.size

       # 3. MIDDLE SPACER (Separates logo from buttons)
        Widget:
            size_hint_y: 0.05

        # 4. RESPONSIVE BUTTONS CONTAINER
        BoxLayout:
            orientation: 'vertical'
            spacing: dp(20)
            size_hint: (0.8, None)  # Buttons take up 80% of screen width
            height: self.minimum_height
            pos_hint: {'center_x': 0.5}

            GoldButton:
                text: 'PLAY A GAME'
                size_hint_y: None
                height: dp(80)
                on_release: app.change_screen("choose_game")
                #adds the flicker animation
                on_kv_post: anim = Animation(text_alpha=1.0, duration=2.2) + Animation(text_alpha=0.3, duration=0.05) + Animation(text_alpha=1.0, duration=0.06) + Animation(text_alpha=0.5, duration=0.04) + Animation(text_alpha=1.0, duration=1.2) + Animation(text_alpha=0.2, duration=0.08) + Animation(text_alpha=0.8, duration=0.04) + Animation(text_alpha=1.0, duration=0.05) + Animation(text_alpha=1.0, duration=3.0); anim.repeat = True; anim.start(self)


            GoldButton:
                text: 'STATS'
                text_color: app.text_color2
                size_hint_y: None
                height: dp(80)
                on_release: app.change_screen("stats_screen")
            GoldButton:
                text: 'SETTINGS'
                text_color: app.text_color2
                size_hint_y: None
                height: dp(80)
                on_release: app.change_screen("settings_screen")

        # 5. BOTTOM SPACER (Pushes footer down gracefully)
        Widget:
            size_hint_y: 0.15

        # 6. FOOTER CONTAINER
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(30)
            Label:
                text: "v 1.0.0 Kivy Framework"
                font_size: '14sp'
                color: (0.5, 0.5, 0.5, 1)
                halign: 'center'
                valign: 'middle'
                text_size: self.size