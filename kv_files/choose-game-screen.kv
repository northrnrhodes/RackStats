#:import utils kivy.utils

<ChooseGameScreen>
    # Set the dark blue background for the entire screen
    canvas.before:
        Color:
            rgba: utils.get_color_from_hex(app.main_color)
        Rectangle:
            size: self.size
            pos: self.pos

    # Main layout using a flexible vertical structure with padding
    BoxLayout:
        orientation: 'vertical'
        padding: [dp(24), dp(30), dp(24), dp(30)]
        spacing: dp(15)

        # 1. TOP SAFE AREA (Flexible spacer for notches/status bars)
        Widget:
            size_hint_y: 0.1

        # 2. TITLE SECTION (Properly centered)
        Label:
            text: "GAME TYPE:"
            font_size: '30sp'
            bold: True
            color: utils.get_color_from_hex(app.text_color2)
            size_hint: (1, None)
            height: dp(40)
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        # Spacer between title and buttons
        Widget:
            size_hint_y: 0.05

        # 3. BUTTONS CONTAINER (Centered elements with responsive spacing)
        BoxLayout:
            orientation: 'vertical'
            spacing: dp(35)
            size_hint: (1, None)
            height: self.minimum_height
            pos_hint: {'center_x': 0.5}

            # 8-Ball Button (Smaller touch area, larger overlapping image)
            Button:
                background_color: 0, 0, 0, 0
                background_normal: ''
                opacity: 0.6 if self.state == 'down' else 1.0
                on_release: app.get_game_type("8 Ball"); app.check_unfinished_match()

                size_hint: (None, None)
                width: dp(120)   # Smaller touch bounding box width
                height: dp(120)  # Smaller touch bounding box height
                pos_hint: {'center_x': 0.5}

                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex(app.main_color)

                Image:
                    source: 'images/8Ball.png'
                    allow_stretch: True
                    keep_ratio: True
                    size: (dp(170), dp(170))  # Larger image size that extends past touch area
                    center_x: self.parent.center_x
                    center_y: self.parent.center_y

            # 9-Ball Button (Smaller touch area, larger overlapping image)
            Button:
                background_color: 0, 0, 0, 0
                background_normal: ''
                opacity: 0.6 if self.state == 'down' else 1.0
                on_release: app.get_game_type("9 Ball"); app.check_unfinished_match()

                size_hint: (None, None)
                width: dp(120)   # Smaller touch bounding box width
                height: dp(120)  # Smaller touch bounding box height
                pos_hint: {'center_x': 0.5}

                canvas.before:
                    Color:
                        rgba: utils.get_color_from_hex(app.main_color)

                Image:
                    source: 'images/9Ball.png'
                    allow_stretch: True
                    keep_ratio: True
                    size: (dp(170), dp(170))  # Larger image size that extends past touch area
                    center_x: self.parent.center_x
                    center_y: self.parent.center_y

        # Spacer between buttons and back button
        Widget:
            size_hint_y: 0.1

       # 4. BACK BUTTON (Fixed dimensions to prevent stretching in fullscreen)
        Button:
            text: "BACK"
            on_release: app.change_screen("home_screen", 'right')
            background_color: 0, 0, 0, 0
            background_normal: ''
            opacity: 0.6 if self.state == 'down' else 1.0

            color: utils.get_color_from_hex(app.text_color2)
            bold: True
            font_size: '30sp'
            font_name: "fonts/Avenir Next.ttc"

            # Enforce strict dimensions across window resizing
            size_hint: None, None
            width: dp(160)
            height: dp(50)
            pos_hint: {'center_x': 0.5}

            canvas.before:
                Color:
                    rgba: utils.get_color_from_hex(app.charcoal_2)
                RoundedRectangle:
                    size: self.size
                    pos: self.pos
                    radius: [dp(15)]
                Color:
                    rgba: 1, 1, 1, 0.6
                Line:
                    width: dp(1.0)
                    rounded_rectangle: (self.x, self.y, self.width, self.height, dp(15))

        # 5. BOTTOM FLEXIBLE SPACE
        Widget:
            size_hint_y: 0.25