#:import utils kivy.utils
#:import StringProperty kivy.properties.StringProperty
#:import Window kivy.core.window.Window


# --- PLAYER SLOT COMPONENT ---
<PlayerSlot@BoxLayout>:
   # Create a property to pass the title (Player 1 or Player 2)
    title: "Player"
    name_label: player_name_lbl

    orientation: 'vertical'
    size_hint_y: None
    height: dp(140) # Fixed height prevents collapsing
    size_hint_x: 0.48

    # [left, top, right, bottom] padding
    # This creates equal "buffer" space around the group
    padding: [dp(10), dp(15), dp(10), dp(15)]
    # This creates equal spacing between the 3 elements
    spacing: dp(15)

    canvas.before:
        Color:
            rgba: 1, 1, 1, 0.2
        Line:
            width: dp(1.5)
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(10))

    Label:
        text: root.title # Uses the property defined above
        font_size: '16sp'
        color: utils.get_color_from_hex(app.text_color2)
        size_hint_y: None
        height: dp(20)

    Label:
        id: player_name_lbl
        text: (app.player1.name if app.player1 and hasattr(app.player1, 'name') else "") if root.title == "Player 1" else (app.player2.name if app.player2 and hasattr(app.player2, 'name') else "")
        font_size: '20sp'
        bold: True
        size_hint_y: None
        height: dp(30)
        # Centering properties for your empty string state
        text_size: self.size
        halign: 'center'
        valign: 'middle'
        color: utils.get_color_from_hex(app.text_color1) #player name appears in green

    # Smaller Edit Button
    GoldButton:
        text: "Edit"
        text_color: app.text_color2
        size_hint: None, None
        width: dp(50) # Fixed size for the button
        font_size: '16sp'
        height: dp(25)
        pos_hint: {'center_x': 0.5}
         #  Pass the ID (1 or 2) to the screen
        on_release: app.root.ids.setup_screen.show_popup(1 if root.title == "Player 1" else 2)


<SetupScreen>:
    canvas.before:
        Color:
            rgba: utils.get_color_from_hex(app.main_color)
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        size_hint_x: None
        width: min(Window.width * 0.95, dp(420))
        pos_hint: {'center_x': 0.5}
        padding: dp(20)
        spacing: dp(10)

        # 1. TOP SAFE AREA (Notch padding
        Widget:
            size_hint_y: None
            height: dp(20)

        Label:
            text: "SETUP MATCH"
            size_hint_y: None
            height: dp(80)
            font_size: '32sp'
            color: utils.get_color_from_hex(app.text_color2)
        Label:
            text: app.game_type
            size_hint_y: None
            height: dp(45)
            font_size: '24sp'
            color: utils.get_color_from_hex(app.text_color1)

        # Main horizontal container
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(150)
            spacing: dp(10)

            PlayerSlot:
                id: p1_slot
                title: "Player 1"

            Label:
                text: "vs"
                size_hint_x: 0.2
                font_size: '30sp'
                color: utils.get_color_from_hex(app.text_color2)

            PlayerSlot:
                id: p2_slot
                title: "Player 2"

        Label:
            height: dp(40)
            size_hint_y: None
            text: 'Shoots First'
            color: utils.get_color_from_hex(app.text_color2)
            font_size: '16sp'
            pos_hint: {'center_x': 0.5, 'center_y':0.5}
            padding: 0, 10, 0, 10


        #Toggle switch container
        BoxLayout:
            orientation: 'horizontal'
            size_hint_x: None
            width: dp(150)
            pos_hint: {'center_x': 0.5}
            size_hint_y: None
            height: dp(30)

            CustomToggle:
                id: player1_breaks
                text: 'Player 1'
                group: 'shoots_first'
                state: 'down'
                on_press: root.validate_toggle(self)

            CustomToggle:
                id: player2_breaks
                text: 'Player 2'
                side: 'right'
                group: 'shoots_first'
                on_press: root.validate_toggle(self)

        #Small spacer for the gap between Toggles and Start Match
        Widget:
            size_hint_y: None
            height: dp(30)

        # --- Error Label (Blank by default) ---
        Label:
            id: setup_error_label
            text: ""
            color: (1, 0, 0, 1)  # Red text for errors
            size_hint_y: None
            height: dp(30)
            font_size: '16sp'
            halign: 'center'
            valign: 'middle'

        # 3. START MATCH Button (Below the player boxes)
        GoldButton:
            text: "START MATCH"
            size_hint_x: 0.6
            size_hint_y: None
            font_size: '26sp'
            height: dp(60)
            pos_hint: {'center_x': 0.5}
            on_release: root.start_match()
            on_kv_post: anim = Animation(text_alpha=1.0, duration=2.2) + Animation(text_alpha=0.3, duration=0.05) + Animation(text_alpha=1.0, duration=0.06) + Animation(text_alpha=0.5, duration=0.04) + Animation(text_alpha=1.0, duration=1.2) + Animation(text_alpha=0.2, duration=0.08) + Animation(text_alpha=0.8, duration=0.04) + Animation(text_alpha=1.0, duration=0.05) + Animation(text_alpha=1.0, duration=3.0); anim.repeat = True; root.bind(players_ready=lambda inst, val: anim.start(self) if val else anim.stop(self)); anim.start(self) if root.players_ready else None



        Widget: # Pushes everything to the top
            size_hint_y: 1.0

        GoldButton:
            text: "BACK"
            size_hint_x: 0.5
            size_hint_y: None
            height: dp(50)
            font_size: '30sp'
            text_color: app.text_color2
            pos_hint: {'center_x': 0.5}
            on_release: app.change_screen('choose_game', 'right')

        # This provides the bottom safe area padding
        Widget:
            size_hint_y: None
            height: dp(30) # This is your custom bottom safe area buffer



# Define the Popup UI
<PlayerPopup>:
    size_hint: (0.8, 0.5)
    title: "Manage Player"
    title_align: 'center'  # Centers "Select Player" text
    separator_color: utils.get_color_from_hex(app.text_color2)
    # Pushes the popup higher on the screen
    pos_hint: {'center_x': 0.5, 'top': 0.9}

    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(10)

        # Scrollable list of players
        ScrollView:
            size_hint_y: 0.6
            BoxLayout:
                id: player_list_grid
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)
                padding: dp(10)

        # Input area
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.3
            spacing: dp(15)

            TextInput:
                id: new_player_input
                hint_text: "New player name..."
                size_hint_x: 0.5 # <--- Half the width of the popup
                #make sure the input field is centered in popup
                pos_hint: {'center_x': 0.5}
                multiline: False
                size_hint_y: None
                height: dp(40)
                width: dp(80)
                focus: True

            GoldButton:
                text: "Save/Add"
                font_size: '16sp'
                size_hint_y: None
                height: dp(40)
                width: dp(100)

                #Explicitly center the button
                pos_hint: {'center_x': 0.5}
                on_release: root.finalize_selection(new_player_input.text)



<CustomToggle@ToggleButton>
    size_hint: None, None
    height: dp(25)
    width:  dp(75)
    side: 'left'


    # Remove the default Kivy grey button background
    background_color: 0, 0, 0, 0
    background_down: ''
    background_normal: ''

    canvas.before:
        Color:
            rgba: (1, 1, 1, 0.2) if self.state == 'down' else (0, 0, 0, 0)
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [dp(10), 0, 0, dp(10)] if self.side == 'left' else [0, dp(10), dp(10), 0]



       #Dynamic border color (Bright amber when active, subtle faint white/grey when inactive)
        Color:
            rgba: utils.get_color_from_hex(app.text_color2) if self.state == 'down' else (1, 1, 1, 0.15)

        # Dynamic border width (Slightly thicker when active to make it pop)
        Line:
            width: dp(2.0) if self.state == 'down' else dp(1.0)
            rounded_rectangle:
                (self.x, self.y, self.width, self.height, dp(10), 0, 0, dp(10)) if self.side == 'left' \
                else (self.x, self.y, self.width, self.height, 0, dp(10), dp(10), 0)

    # 2. The suppressed tap animation
    opacity: 0.6 if self.state == 'down' else 1.0

    # Text styling (Dark blue text to match the app background)
    color: utils.get_color_from_hex('#4CEB63') if self.state == 'down' else utils.get_color_from_hex(app.text_color2)
    bold: True
    font_size: '16sp'

