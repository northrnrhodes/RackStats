#:import utils kivy.utils

<CLockWidget@BoxLayout>:
    #makes elements side by side
    orientation: 'horizontal'
    pos_hint: {'center_y': 0.5}

    # add space between play/pause icons and timer text
    spacing: 10
     # adds a little padding on the sides
    padding: [10, 0, 10, 0]
    size_hint_y: None
    #makes widget only take up 35% of screen
    size_hint_x: 0.28
    height: dp(50)
    #centers the widget
    pos_hint: {'center_x': 0.5}

    canvas.before:
        #set border color
        Color:
            rgba: utils.get_color_from_hex(app.accent_color)
        Line:
            #draw rounded rectangle
            rounded_rectangle: (self.x, self.y, self.width, self.height, 20)
            width: 2.5

    ImageButton:
        id: play_pause_btn
        size_hint: None, None
        size: '25dp', '25dp'
        pos_hint: {'center_y': 0.5}
        allow_stretch: True
        keep_ratio: True
        source: 'images/pause.png' if app.is_running else 'images/play.png'
        on_release: app.start_timer() if not app.is_running else app.stop_timer()


    Label:
        text: app.timer_text
        font_size: '24sp'
        valign: 'middle'
        color: utils.get_color_from_hex(app.accent_color)




# --- PLAYER SLOT COMPONENT ---
<PlayerBox@BoxLayout>:
   # Create a property to pass the title (Player 1 or Player 2)
    player_name: ''
    is_active: False
    defensive_count: 0
    wins_count: 0
    orientation: 'vertical'
    size_hint_y: None
    height: dp(140) # Fixed height prevents collapsing


    canvas.before:
        Color:
            rgba: (1, 1, 1, 0.2) if root.is_active else (0, 0, 0, 0)
        Rectangle:
            size: self.size
            pos: self.pos



        #border styling logic
        Color:
            rgba: utils.get_color_from_hex(app.accent_color)
        Line:
            width: dp(1.5)
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(10))

    Label:
        text: root.player_name
        font_size: '30sp'
        color: utils.get_color_from_hex(app.accent_color)
        text_size: (self.width, self.height) # Forces the label to fill the box
        halign: 'center'
        valign: 'top' # Pins text to the top
        padding: [0, 10, 0, 0] # Small offset to keep text off the border


    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: 0.5 # Takes up half the remaining space
        spacing: dp(10)
        padding: [dp(20), 0, dp(20), 0]

        Image:
            source: 'images/trophy.png'
            size_hint_x: None
            width: dp(25)
            allow_stretch: True
            keep_ratio: True

        Label:
            text: str(root.wins_count)
            font_size: '20sp'
            color: utils.get_color_from_hex(app.accent_color)
            # ### CHANGED: Set size_hint_x to fill space between icons
            size_hint_x: 0.5

        Image:
            source: 'images/shield.png'
            size_hint_x: None
            width: dp(25)
            allow_stretch: True
            keep_ratio: True

        Label:
            text: str(root.defensive_count)
            font_size: '20sp'
            color: utils.get_color_from_hex(app.accent_color)
            # ### CHANGED: Set size_hint_x to fill space between icons
            size_hint_x: 0.5

    Widget: # Pushes everything to the top
        size_hint_y: .1



# Set the dark blue background for the entire screen
<MatchScreen8>
    canvas.before:
        Color:
            rgba: utils.get_color_from_hex(app.main_color)
        Rectangle:
            size: self.size
            pos: self.pos

    BoxLayout:
        orientation: 'vertical'

        # 1. TOP SAFE AREA (Notch padding)
        Widget:
            size_hint_y: None
            height: dp(60)


        #custom navbar at the top
        NavBar:


        # Main horizontal container containing player cards
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(150)
            spacing: dp(10)
            padding: (25, 0, 25, 0)

            PlayerBox:
                player_name: app.player1.name if app.player1 else "Player 1"
                defensive_count: app.p1_safe
                wins_count: app.p1_wins
                is_active: app.current_player == app.player1


            Label:
                text: "vs"
                size_hint_x: 0.2
                font_size: '35sp'
                color: utils.get_color_from_hex(app.accent_color)

            PlayerBox:
                player_name: app.player2.name if app.player2 else "Player 2"
                defensive_count: app.p2_safe
                wins_count: app.p2_wins
                is_active: app.current_player == app.player2



        Widget:
            size_hint_y: None
            height: dp(30)


        ClockWidget:


        Widget:
            size_hint_y: .1

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.25
            size_hint_y: .1
            pos_hint: {'center_x': 0.5}
            Label:
                text: f'Total Innings: {str(app.innings)}'
                font_size: '20sp'

        Widget:
            size_hint_y: .1

        BoxLayout:
            orientation: 'vertical'
            spacing: dp(20)

            GoldButton:
                text: f"{app.current_player.name if app.current_player and app.current_player.name else 'Player'} 's turn over"
                font_size: '20sp'
                size_hint: (.5, .05)
                on_release: root.change_player()

            SafetyToggle:
                id: safety_toggle
                text: 'Safety'
                size_hint: (.5, .05)
                font_size: '20sp'

            GoldButton:
                text: 'Game Over'
                size_hint: (.5, .05)
                font_size: '20sp'
                on_release: root.show_popup()


            GoldButton:
                text: 'Previous turn'
                size_hint: (.5, .05)
                font_size: '20sp'
                disabled: app.rack_turn_count == 0
                on_release: root.previous_player()



        Widget: # Pushes everything to the top
            size_hint_y: 1.0


<PoolBallToggle@ToggleButtonBehavior+Image>:
    #image constraints
    allow_stretch: True
    keep_ratio: True

    # 2. Automatically drop the opacity to 50% when selected
    opacity: 0.2 if self.state == 'down' else 1.0

    # 3. Keep the size constraints so they scale perfectly
    size_hint: (1, 1)




<SafetyToggle@ToggleButton>
    # Remove the default Kivy grey button background
    background_color: 0, 0, 0, 0
    background_normal: ''

    # Text styling (Dark blue text to match the app background)
    color: utils.get_color_from_hex(app.main_color)
    bold: True
    font_size: '22sp'

    # Sizing (Fixed size so they look uniform)
    size_hint: None, None
    size: dp(260), dp(100)
    pos_hint: {'center_x': 0.5}

    # Drawing the rounded rectangle and border
    canvas.before:
        Color:
            rgba: utils.get_color_from_hex(app.accent_color) if self.state == "normal" else (1,1,1,1)
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [dp(15)] # The curve of the corners

        # Optional: Adds the thin light border seen in your mockup
        Color:
            rgba: 1, 1, 1, 0.6
        Line:
            width: dp(1.0)
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(15))



# Define the standard game end Popup UI
<GameEndPopup>:
              #width x height
    size_hint: (0.85, 0.90)

    #minimum constraints for responsiveness
    size_hint_min_x: dp(300)
    size_hint_max_x: dp(450)

    #default title is empty string
    title: ""

    separator_height: 0  # Hide Kivy's default top separator line
    # Pushes the popup higher on the screen
    pos_hint: {'center_x': 0.5, 'top': 0.95}
    auto_dismiss: False

    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(10)

        #custom title label with "X" button
        BoxLayout:
            size_hint_y: None
            height: dp(40)
            padding: [0, dp(2), 0, dp(2)]

            Label:
                text: "What happened?"
                font_size: '18sp'
                bold: True
                halign: 'center'
                valign: 'middle'

            Button:
                text: "X"
                size_hint: (None, None)
                height: self.parent.height * 0.5
                width: self.height
                font_size: '14sp'
                pos_hint: {'center_y': 0.5}
                background_normal: ''
                background_color: (0.8, 0.2, 0.2, 1)
                on_release: root.dismiss()

        # --- Custom Separator Line below the header ---
        Widget:
            size_hint_y: None
            height: dp(2)
            canvas:
                Color:
                    rgba: utils.get_color_from_hex(app.accent_color)
                Rectangle:
                    pos: self.pos
                    size: self.size

        #Main container that holds error labels, buttons and ball selectors.
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.88
            spacing: dp(8)
            padding: [dp(5), dp(5), dp(5), dp(5)]

             # New error label
            Label:
                id: error_label
                text: ""
                color: 1, 0, 0, 1 # Red text
                font_size: '14sp'
                size_hint_y: 0.05


            SafetyToggle:
                group: 'game_over'
                id: made_8ball
                text: 'Made 8 Ball'
                size_hint: (0.8, 0.10)
                font_size: '15sp'

            SafetyToggle:
                group: 'game_over'
                id: early_8
                text: 'Made 8 ball early'
                size_hint: (0.8, 0.10)
                font_size: '15sp'

            SafetyToggle:
                group: 'game_over'
                id: wrong_pocket
                text: '8 Ball wrong pocket'
                size_hint: (0.8, 0.10)
                font_size: '15sp'


            SafetyToggle:
                group: 'game_over'
                id: scratched
                text: 'Scratched on 8 Ball'
                size_hint: (0.8, 0.10)
                font_size: '15sp'


            Widget:
                size_hint_y: .05


            #Toggle buttons for selecting opponent balls remaining
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(2)
                size_hint_y: 0.28

                Label:
                    text: 'Opp. Balls Remaining'
                    font_size: '14sp'
                    size_hint_y: 0.20
                    color: utils.get_color_from_hex(app.accent_color)



                #pool ball image buttons
                #row 1, balls 0, 1, 2, 3
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: .4
                    spacing: dp(6)
                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'opp_balls')
                        group: 'opp_balls'
                        source: 'images/cue_ball.png'
                        ball_value: 0
                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'opp_balls')
                        group: 'opp_balls'
                        source: 'images/one_ball.png'
                        ball_value: 1
                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'opp_balls')
                        group: 'opp_balls'
                        source: 'images/two_ball.png'
                        ball_value: 2
                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'opp_balls')
                        group: 'opp_balls'
                        source: 'images/three_ball.png'
                        ball_value: 3

                # Row 2, balls 4, 5, 6, 7
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: 0.4
                    spacing: dp(6)

                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'opp_balls')
                        group: 'opp_balls'
                        source: 'images/four_ball.png'
                        ball_value: 4
                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'opp_balls')
                        group: 'opp_balls'
                        source: 'images/five_ball.png'
                        ball_value: 5
                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'opp_balls')
                        group: 'opp_balls'
                        source: 'images/six_ball.png'
                        ball_value: 6
                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'opp_balls')
                        group: 'opp_balls'
                        source: 'images/seven_ball.png'
                        ball_value: 7


            #spacer widget to separate the opponent balls and current player balls containers
            Widget:
                size_hint_y: .015


            #dynamic BoxLayout appears when 'made 8 early' button state == down
            #select current players balls remaining
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(2)
                # If made_8ball is down, it expands to 0.34. Otherwise, it collapses to 0 height.
                size_hint_y: 0.28
                opacity: 1 if early_8.state == 'down' else 0
                disabled: early_8.state != 'down'

                Label:
                    text: 'Current player balls remaining'
                    font_size: '14sp'
                    size_hint_y: 0.20
                    color: utils.get_color_from_hex(app.accent_color)

                #pool ball image buttons (Row 1)
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: .4
                    spacing: dp(6)

                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'player_balls')
                        group: 'player_balls'
                        source: 'images/cue_ball.png'
                        ball_value: 0
                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'player_balls')
                        group: 'player_balls'
                        source: 'images/one_ball.png'
                        ball_value: 1
                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'player_balls')
                        group: 'player_balls'
                        source: 'images/two_ball.png'
                        ball_value: 2
                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'player_balls')
                        group: 'player_balls'
                        source: 'images/three_ball.png'
                        ball_value: 3


                # Row 2
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: .4
                    spacing: dp(6)

                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'player_balls')
                        group: 'player_balls'
                        source: 'images/four_ball.png'
                        ball_value: 4
                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'player_balls')
                        group: 'player_balls'
                        source: 'images/five_ball.png'
                        ball_value: 5
                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'player_balls')
                        group: 'player_balls'
                        source: 'images/six_ball.png'
                        ball_value: 6
                    PoolBallToggle:
                        on_press: root.on_ball_toggle(self, self.state, 'player_balls')
                        group: 'player_balls'
                        source: 'images/seven_ball.png'
                        ball_value: 7


        Widget:
            size_hint_y: 0.1


        GoldButton:
            text: 'Submit'
            size_hint: (.5, 0.10)
            font_size: '15sp'
            on_release: root.get_game_results()



#define 8 Ball break or Break and run popup
<BreakGameEnd>
    size_hint: (0.8, 0.5)
    title: ""

    separator_height: 0  # Hide Kivy's default top separator line
    # Pushes the popup higher on the screen
    pos_hint: {'center_x': 0.5, 'top': 0.9}
    auto_dismiss: False

    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(15)

        #custom title label with "X" button
        BoxLayout:
            size_hint_y: None
            height: dp(30)

            Label:
                text: "What happened?"
                font_size: '18sp'
                bold: True
                halign: 'center'
                valign: 'middle'

            Button:
                text: "X"
                size_hint: (None, None)
                size: dp(30), dp(30)
                font_size: '14sp'
                background_normal: ''
                background_color: (0.8, 0.2, 0.2, 1)
                on_release: root.dismiss()

        # --- Custom Separator Line below the header ---
        Widget:
            size_hint_y: None
            height: dp(2)
            canvas:
                Color:
                    rgba: utils.get_color_from_hex(app.accent_color)
                Rectangle:
                    pos: self.pos
                    size: self.size


         # New error label
        Label:
            id: error_label
            text: ""
            color: 1, 0, 0, 1 # Red text
            font_size: '14sp'
            size_hint_y: None
            height: dp(30)



        SafetyToggle:
            group: 'game_over'
            id: eight_ball_break
            text: '8 Ball break'
            size_hint: (.5, .05)
            font_size: '15sp'


        SafetyToggle:
            group: 'game_over'
            id: break_and_run
            text: 'Break and Run'
            size_hint: (.5, .05)
            font_size: '15sp'


        SafetyToggle:
            group: 'game_over'
            id: scratched
            text: 'Made 8 ball but scratched'
            size_hint: (.5, .05)
            font_size: '15sp'


        Widget:
            size_hint_y: 0.1


        GoldButton:
            text: 'Submit'
            size_hint: (.5, .05)
            font_size: '15sp'
            on_release: root.get_game_results()



<NavBar@BoxLayout>
    id: nav_bar
    game_type: app.game_type
    match_time: app.match_time
    padding: [dp(15), dp(0), dp(15), dp(0)]
    spacing: dp(10)


    orientation: 'horizontal'
    size_hint_y: None
    height: dp(45)
    #bottom seperator line
    canvas.before:
        Color:
            rgba: utils.get_color_from_hex(app.accent_color)
        Rectangle:
            pos: self.x, self.y
            #set width to take up entire screen and thickness of line to dp(2)
            size: self.width, dp(2)
    BoxLayout:
        size_hint_x: 0.25
        Button:
            text: '< Menu'
            font_size: '18sp'
            size_hint_x: 1
            background_color: 0, 0, 0, 0
            color: utils.get_color_from_hex(app.accent_color)
            on_release: app.menu_button()

    Label:
        text: root.game_type
        color: utils.get_color_from_hex(app.accent_color)
        size_hint_x: 0.5
        font_size: '18sp'
        bold: True
        text_size: self.size
        halign: 'center'
        valign: 'middle'

    BoxLayout:
        size_hint_x: 0.25
        Label:
            text: root.match_time
            color: utils.get_color_from_hex(app.accent_color)
            size_hint_x: 1
            font_size: '18sp'
            halign: 'right'
            valign: 'middle'


#main menu quit game popup

<ExitGamePopup>
    size_hint: (0.5, 0.2)
    title: "Are you sure you want to exit? All current progress will be lost."

    separator_height: 0  # Hide Kivy's default top separator line
    # Pushes the popup higher on the screen
    pos_hint: {'center_x': 0.5, 'top': 0.9}
    auto_dismiss: False
    BoxLayout:
        orientation: 'horizontal'
        padding: 10, 0, 10, 0
        spacing: dp(10)

        GoldButton:
            text: 'Yes'
            size_hint: .2, .2

            on_release: root.quit_game()


        GoldButton:
            text: 'No'
            size_hint: .2, .2
            on_release: root.close()

