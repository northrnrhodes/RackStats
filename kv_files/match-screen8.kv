#:import utils kivy.utils


# Set the dark blue background for the entire screen
<MatchScreen8>
    canvas.before:
        Color:
            rgba: utils.get_color_from_hex(app.main_color)
        Rectangle:
            size: self.size
            pos: self.pos

    BoxLayout:
        orientation: 'vertical'
        size_hint_x: None
        width: min(Window.width * 0.95, dp(420))
        pos_hint: {'center_x': 0.5}

        # 1. TOP SAFE AREA (Notch padding)
        Widget:
            size_hint_y: None
            height: dp(60)


        #custom navbar at the top
        NavBar:


        # Main horizontal container containing player cards
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(150)
            spacing: dp(10)
            padding: (25, 0, 25, 0)

            PlayerBox:
                id: p1_box
                player_name: app.player1.name if app.player1 else ""
                defensive_count: app.p1_safe
                wins_count: app.p1_wins
                is_active: app.current_player == app.player1


            Label:
                text: "vs"
                size_hint_x: 0.2
                font_size: '35sp'
                color: utils.get_color_from_hex(app.text_color2)

            PlayerBox:
                id: p2_box
                player_name: app.player2.name if app.player2 else ""
                defensive_count: app.p2_safe
                wins_count: app.p2_wins
                is_active: app.current_player == app.player2



        Widget:
            size_hint_y: None
            height: dp(30)


        ClockWidget:


        Widget:
            size_hint_y: .1

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.25
            size_hint_y: .1
            pos_hint: {'center_x': 0.5}
            Label:
                text: f'Total Innings: {str(app.innings)}'
                font_size: '20sp'

        Widget:
            size_hint_y: .1

        BoxLayout:
            orientation: 'vertical'
            spacing: dp(20)

            GoldButton:
                text: f"{app.current_player.name if app.current_player and app.current_player.name else 'Player'}'s turn over"
                font_size: '20sp'

                size_hint: (.5, .05)
                on_release: root.change_player()

            SafetyToggle:
                id: safety_toggle
                text: 'Safety'
                size_hint: (.5, .05)
                font_size: '20sp'

            GoldButton:
                text: 'Game Over'
                size_hint: (.5, .05)
                font_size: '20sp'
                on_release: root.show_popup()


            GoldButton:
                text: 'Previous turn'
                color: utils.get_color_from_hex(app.text_color2)
                size_hint: (.5, .05)
                font_size: '20sp'
                disabled: app.rack_turn_count == 0
                on_release: root.previous_player()



        Widget: # Pushes everything to the top
            size_hint_y: 1.0
