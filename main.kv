GridLayout:
    cols: 1

    ScreenManager:
        id: screen_manager

        StartupScreen:
            id: startup_screen
            name: "startup_screen"

        HomeScreen:
            id: home_screen
            name: "home_screen"

        StatsScreen:
            id: stats_screen
            name: "stats_screen"

        ChooseGameScreen:
            id: choose_game
            name: "choose_game"

        SettingsScreen:
            id: settings_screen
            name: "settings_screen"
